+def _validate_pool_window(window: int, stride: int) -> tuple[int, int]:
+    """Return (window, stride); stride defaults to the window (no overlap)."""
+    window = int(window)
+    stride = int(stride) or window
+    if window <= 0 or not 0 < stride <= window:
+        raise ValueError(
+            "init_strategy=text_mean_pool_window requires soft_prefix.init_pool_window > 0 and "
+            f"0 < init_pool_stride <= init_pool_window (got window={window}, stride={stride})"
+        )
+    return window, stride
+
+
+def text_window_pool_starts(n_tokens: int, window: int, stride: int) -> list[int]:
+    """Start offsets of `window`-token windows taken every `stride` tokens; the last window may be shorter."""
+    if n_tokens <= window:
+        return [0]
+    return list(range(0, n_tokens - window + stride, stride))
+
+
+def _initialize_prefix_from_text_window_pool(
+    torch, model, tokenizer, prefix_embeddings, text: str, window: int, stride: int
+) -> None:
+    """Initialize prefix row i as the mean of the skill-text token embeddings in window i (overlapping if stride < window)."""
+    input_ids = tokenizer(text, add_special_tokens=False, return_tensors="pt")["input_ids"]
+    if input_ids.numel() == 0:
+        raise ValueError("init_strategy=text_mean_pool_window requires a non-empty init_text_path document")
+    starts = text_window_pool_starts(input_ids.shape[1], window, stride)
+    if len(starts) != prefix_embeddings.shape[0]:
+        raise ValueError(
+            f"init_strategy=text_mean_pool_window gives {len(starts)} rows for {input_ids.shape[1]} tokens "
+            f"(window={window}, stride={stride}); set soft_prefix.prefix_length to auto or {len(starts)}"
+        )
+    with torch.no_grad():
+        embeds = model.get_input_embeddings()(input_ids.to(prefix_embeddings.device))[0].float()
+        pooled = torch.stack([embeds[start : start + window].mean(dim=0) for start in starts])
+        prefix_embeddings.copy_(pooled.to(prefix_embeddings.dtype))
+
