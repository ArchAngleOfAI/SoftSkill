+# Optional Docker sandbox for model-generated code. Set SOFTSKILL_SHEET_SANDBOX_IMAGE to an
+# image name to enable it; when unset, code runs on the host exactly as upstream does.
+SANDBOX_IMAGE_ENV = "SOFTSKILL_SHEET_SANDBOX_IMAGE"
+_TIMEOUT_EXIT = 124  # coreutils `timeout` exit status when the limit is hit
+
+
+def sandbox_image() -> str:
+    return os.environ.get(SANDBOX_IMAGE_ENV, "").strip()
+
+
+def run_in_sandbox(
+    argv: list[str],
+    *,
+    cwd: str,
+    ro_paths: list[str] = (),
+    rw_dirs: list[str] = (),
+    timeout: int | None = None,
+) -> subprocess.CompletedProcess:
+    """Run argv in a throwaway container: no network, read-only root, capped memory/CPU/PIDs.
+
+    Host paths are mounted at the same absolute paths, so generated code sees the paths it
+    was given. Exit status 124 means the in-container time limit was hit.
+    """
+    import uuid
+
+    name = f"softskill-sheet-{uuid.uuid4().hex[:12]}"
+    cmd = [
+        "docker", "run", "--rm", "--name", name,
+        "--network", "none",
+        "--user", f"{os.getuid()}:{os.getgid()}",
+        "--memory", "4g", "--memory-swap", "4g", "--cpus", "2", "--pids-limit", "256",
+        "--read-only", "--tmpfs", "/tmp:rw,size=512m",
+        "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
+        "-e", "HOME=/tmp", "-e", "MPLCONFIGDIR=/tmp",
+    ]
+    rw = {os.path.realpath(d) for d in rw_dirs}
+    for path in sorted({os.path.realpath(p) for p in ro_paths} - rw):
+        cmd += ["-v", f"{path}:{path}:ro"]
+    for path in sorted(rw):
+        cmd += ["-v", f"{path}:{path}:rw"]
+    cmd += ["-w", os.path.realpath(cwd), sandbox_image()]
+    if timeout and timeout > 0:
+        cmd += ["timeout", "-k", "5", str(int(timeout))]
+    cmd += list(argv)
+    try:
+        # Host-side limit is a backstop; the in-container `timeout` normally fires first.
+        return subprocess.run(cmd, capture_output=True, text=True, timeout=(timeout + 60) if timeout and timeout > 0 else None)
+    except subprocess.TimeoutExpired:
+        subprocess.run(["docker", "kill", name], capture_output=True)
+        raise
+
+
 def run_generated_code(code: str, input_path: str, output_path: str, timeout: int | None = 120) -> tuple[bool, str]:
     os.makedirs(os.path.dirname(output_path), exist_ok=True)
+    if sandbox_image():
+        input_path, output_path = os.path.abspath(input_path), os.path.abspath(output_path)
