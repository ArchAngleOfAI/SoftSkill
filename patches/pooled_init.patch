+def _initialize_prefix_from_text_pool(torch, model, tokenizer, prefix_embeddings, text: str, mode: str) -> None:
+    """Initialize every prefix row from one pooled (element-wise max or mean) skill-text token embedding."""
+    input_ids = tokenizer(text, add_special_tokens=False, return_tensors="pt")["input_ids"]
+    if input_ids.numel() == 0:
+        raise ValueError(f"init_strategy=text_{mode}_pool requires a non-empty init_text_path document")
+    with torch.no_grad():
+        embeds = model.get_input_embeddings()(input_ids.to(prefix_embeddings.device))[0].float()
+        pooled = embeds.max(dim=0).values if mode == "max" else embeds.mean(dim=0)
+        prefix_embeddings.copy_(pooled.to(prefix_embeddings.dtype).unsqueeze(0).expand_as(prefix_embeddings))
+
